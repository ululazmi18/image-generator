# ==============================================================================
# GITIGNORE — GOOGLE FLOW IMAGE GENERATOR
# ==============================================================================

# Browser Profile (CRITICAL SENSITIVE: Google login credentials, cookies, tokens)
browser_profile/
*.default-release/
*.default/
profile/

# Portable Browser Binaries & Download Packages
firefox_portable/
*.paf.exe
*.installer.exe

# Output & Debug Directories (Preserve folders via .gitkeep)
outputs/*
!outputs/.gitkeep
debug/*
!debug/.gitkeep
screenshots/
reports/

# Dynamic WebExtension Build Artifacts
stealth_addon/*.xpi
*.xpi

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
env/
venv/
ENV/

# Logs & Temporary Scratch Files
*.log
temp/
tmp/
scratch/
.cache/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.key
*.pem

# IDE & Operating System Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
